utes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320" y="335" width="470" height="70" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b&gt;FuelSphere Service — fuelsphere-srv&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475E75&quot; style=&quot;font-size:11px&quot;&gt;SAP CAP (Node.js 22) · OData V4 · 17 services&lt;br&gt;Planning · Orders &amp;amp; ePOD · Tickets · Burn &amp;amp; ROB · Pricing&lt;br&gt;Invoice readiness checks · Master data sync&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320" y="425" width="470" height="110" as="geometry"/></mxCell><mxCell id="hdb" value="&lt;b&gt;DB deployer — fuelsphere-db-deployer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475E75&quot; style=&quot;font-size:11px&quot;&gt;HDI artefacts from CDS model&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320" y="555" width="470" height="65" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;SAP BTP services&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=14;fontColor=#0070F2;strokeColor=#0070F2;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="185" width="310" height="455" as="geometry"/></mxCell><mxCell id="hana" value="&lt;b&gt;SAP HANA Cloud&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475E75&quot; style=&quot;font-size:11px&quot;&gt;HDI container (hdi-shared)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontColor=#1D2D3