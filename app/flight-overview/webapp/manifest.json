{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.fuelsphere.planning.flightoverview",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap-ux/fiori-elements-writer:ovp",
      "version": "3.1.45"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/planning/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "annotations": []
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ovp": {},
        "sap.ui.rta": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.fuelsphere.planning.flightoverview.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "mainModel": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [],
      "targets": {}
    }
  },
  "sap.ovp": {
    "globalFilterModel": "mainModel",
    "globalFilterEntitySet": "FlightSchedule",
    "containerLayout": "resizable",
    "enableLiveFilter": true,
    "considerAnalyticalParameters": false,
    "cards": {
      "card00_fuelStatus": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Fuel status",
          "subTitle": "the reconciliation verdict, per delivery",
          "entitySet": "FLIGHT_FUEL_DELIVERIES",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#FuelStatusCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "recon_variance_kg",
          "sortOrder": "descending",
          "valueSelectionInfo": "sorted by variance, largest first"
        }
      },
      "card01_dispatch": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Dispatch plan",
          "subTitle": "the planned stack and the required uplift",
          "entitySet": "FlightDispatches",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#DispatchCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "plan_version",
          "sortOrder": "descending",
          "valueSelectionInfo": "latest plan version first"
        }
      },
      "card02_aircraft": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Aircraft",
          "subTitle": "the tail, and what the model holds about it",
          "entitySet": "FlightAircraft",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#AircraftCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "registration",
          "sortOrder": "ascending",
          "valueSelectionInfo": "MLW, MZFW and engine burn arrive with package B"
        }
      },
      "card03_designation": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Supplier and into-plane agent",
          "subTitle": "who fuels this flight, and the station default beneath it",
          "entitySet": "FlightDesignation",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#DesignationCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "axis_rank",
          "sortOrder": "ascending",
          "valueSelectionInfo": "FLIGHT before STATION; the station default stays visible"
        }
      },
      "card04_orders": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Fuel orders",
          "subTitle": "several are possible on one flight",
          "entitySet": "FuelOrders",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#OrdersCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "order_number",
          "sortOrder": "ascending",
          "valueSelectionInfo": "by order number"
        }
      },
      "card05_tickets": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Fuel tickets",
          "subTitle": "the metered leg, per supplier",
          "entitySet": "FLIGHT_FUEL_TICKETS",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#TicketsCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "delivery_timestamp",
          "sortOrder": "ascending",
          "valueSelectionInfo": "in delivery order"
        }
      },
      "card06_delivery": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Delivery",
          "subTitle": "the gauge pair, the refuel window, the supplier count",
          "entitySet": "FuelDeliveries",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#DeliveryCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "refuel_start_utc",
          "sortOrder": "ascending",
          "valueSelectionInfo": "in refuel order"
        }
      },
      "card07_burn": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Burn",
          "subTitle": "planned against actual, and the split at closure",
          "entitySet": "FuelBurns",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#BurnCard",
          "listType": "extended",
          "listFlavor": "standard",
          "sortBy": "burn_date",
          "sortOrder": "descending",
          "valueSelectionInfo": "most recent burn first"
        }
      }
    },
    "globalFilterControlType": "MacroFilterBar"
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
